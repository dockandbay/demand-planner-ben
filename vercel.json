{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo no-build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "functions": {
    "api/index.mjs": { "includeFiles": "{artifact_v16.7.html,favicon.png,package.json,supply/**,lib/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs,node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs,node_modules/pdfjs-dist/build/pdf.min.mjs,node_modules/pdfjs-dist/build/pdf.worker.min.mjs}", "maxDuration": 300 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
