{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo no-build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "functions": {
    "api/index.mjs": { "includeFiles": "{artifact_v16.7.html,favicon.png,package.json,supply/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs,node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs}", "maxDuration": 300, "memory": 1024 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/cron/action-metrics", "schedule": "59 23 * * 4" }]
}
