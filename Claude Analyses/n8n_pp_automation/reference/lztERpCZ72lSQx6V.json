 "name": "Fulfil | Request (sub-workflow)",
 "description": "Shared Fulfil caller: routes to PROD or SANDBOX credential by tenant name, blocks any PROD write unless allow_prod_write=true, retries and fails loudly.",
 "active": true,
 "isArchived": false,
 "nodes": [
  {
   "id": "1aaef65f-1c8e-4303-9361-23e5449d96c6",
   "name": "Fulfil request input",
   "type": "n8n-nodes-base.executeWorkflowTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    300
   ],
   "parameters": {
    "inputSource": "workflowInputs",
    "workflowInputs": {
     "values": [
      {
       "name": "tenant",
       "type": "string"
      },
      {
       "name": "method",
       "type": "string"
      },
      {
       "name": "path",
       "type": "string"
      },
      {
       "name": "body",
       "type": "any"
      },
      {
       "name": "allow_prod_write",
       "type": "boolean"
      },
      {
       "name": "tag",
       "type": "any"
      }
     ]
    }
   }
  },
  {
   "id": "eec14487-31d9-4a07-bd4a-b6a07094f082",
   "name": "Validate + write guard",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    240,
    300
   ],
   "parameters": {
    "mode": "runOnceForEachItem",
    "language": "javaScript",
    "jsCode": "const tenant = String($json.tenant || '').toUpperCase();\nif (!['PROD', 'SANDBOX'].includes(tenant)) throw new Error('tenant must be PROD or SANDBOX (got \"' + $json.tenant + '\")');\nconst method = String($json.method || '').toUpperCase();\nif (!['PUT', 'POST'].includes(method)) throw new Error('method must be PUT or POST (got \"' + method + '\")');\nconst path = String($json.path || '');\nif (!path.startsWith('/model/')) throw new Error('path must start with /model/ (got \"' + path + '\")');\n// In Fulfil, PUT .../search_read and .../fields_get are READS. Everything else writes.\nconst isRead = method === 'PUT' && /\\/(search_read|fields_get)$/.test(path);\nif (tenant === 'PROD' && !isRead && $json.allow_prod_write !== true) {\n  throw new Error('Blocked: PROD write ' + method + ' ' + path + ' without allow_prod_write=true');\n}\nreturn { json: { tenant, method, path, body: $json.body === undefined ? [] : $json.body, isRead, tag: $json.tag ?? null } };"
   }
  },
  {
   "id": "29a76a56-ec69-430c-a9e6-8850689cd6f7",
   "name": "Route by tenant",
   "type": "n8n-nodes-base.switch",
   "typeVersion": 3.4,
   "position": [
    480,
    300
   ],
   "parameters": {
    "mode": "rules",
    "rules": {
     "values": [
      {
       "outputKey": "PROD",
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict"
        },
        "conditions": [
         {
          "leftValue": "={{ $json.tenant }}",
          "operator": {
           "type": "string",
           "operation": "equals"
          },
          "rightValue": "PROD"
         }
        ],
        "combinator": "and"
       }
      },
      {
       "outputKey": "SANDBOX",
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict"
        },
        "conditions": [
         {
          "leftValue": "={{ $json.tenant }}",
          "operator": {
           "type": "string",
           "operation": "equals"
          },
          "rightValue": "SANDBOX"
         }
        ],
        "combinator": "and"
       }
      }
     ]
    }
   }
  },
  {
   "id": "d799fecc-e349-458d-bc8b-99acb851f93a",
   "name": "Fulfil PROD (dockandbay.fulfil.io)",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.4,
   "position": [
    720,
    200
   ],
   "parameters": {
    "method": "={{ $json.method }}",
    "url": "=https://dockandbay.fulfil.io/api/v2{{ $json.path }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "contentType": "json",
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json.body) }}",
    "options": {
     "response": {
      "response": {
       "fullResponse": true
      }
     },
     "batching": {
      "batch": {
       "batchSize": 3,
       "batchInterval": 1000
      }
     },
     "timeout": 120000
    }
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "j9m8FVwKL7nvn8Lk",
     "name": "Fulfil PROD"
    }
   },
   "retryOnFail": false,
   "notes": "No auto-retry (30 Sept 2026): a retry re-sent POST writes that had already landed. A failed call stops the run; the next run is idempotent."
  },
  {
   "id": "991491f1-ca2e-4e31-853c-ca352daf3257",
   "name": "Shape response",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    960,
    300
   ],
   "parameters": {
    "mode": "runOnceForEachItem",
    "language": "javaScript",
    "jsCode": "const req = $('Validate + write guard').item.json;\nreturn { json: { ok: true, status: $json.statusCode, tenant: req.tenant, method: req.method, path: req.path, tag: req.tag, data: $json.body } };"
   }
  },
