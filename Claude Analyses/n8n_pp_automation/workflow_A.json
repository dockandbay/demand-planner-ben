  {
   "id": "9c2a7a8f-797c-5f57-a40d-63347e2bfd42",
   "name": "Build email",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1540,
    -100
   ],
   "parameters": {
    "jsCode": "\nconst d = $json;\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\nconst rows = d.fresh.map(p => `<tr><td>${esc(p.number)}</td><td>${esc(p.reference)}</td><td>${esc(p.channel)}</td><td>${esc(p.reason)}</td><td>${esc(p.created)}</td><td>${esc(p.exception)}</td></tr>`).join('');\nconst html = `<p><b>${d.fresh.length} new order(s) not processed</b> (${d.outstanding} outstanding in total, tenant ${esc(d.tenant)}). Orders older than the grace period on integrated channels that are draft, quotation, failed, confirmed without a shipment, or carrying an open exception.</p>\n<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse:collapse;font-family:Arial;font-size:12px\"><tr><th>Order</th><th>Reference</th><th>Channel</th><th>Problem</th><th>Created</th><th>Exception</th></tr>${rows}</table>`;\nreturn [{ json: { subject: `Orders not processed (${d.tenant}): ${d.fresh.length} new, ${d.outstanding} outstanding`, html } }];\n"
   }
  },
