  {
   "id": "8caa44c0-5da4-560a-a36d-d0e5995761cf",
   "name": "Split fixes",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2860,
    -160
   ],
   "parameters": {
    "jsCode": "\nconst S = $('Settings').first().json;\nreturn $('Decide').first().json.fixes.map(f => ({ json: f.valueId\n  ? { tenant: S.tenant, method: 'PUT', path: '/model/metafield.value/write', body: [[f.valueId], { value_choice: f.vas }],\n      allow_prod_write: S.allowProdWrite === true, tag: f }\n  : { tenant: S.tenant, method: 'POST', path: '/model/metafield.value',\n      body: [{ field: f.fieldId, resource: 'stock.shipment.out,' + f.shipmentId, value_choice: f.vas }],\n      allow_prod_write: S.allowProdWrite === true, tag: f } }));\n"
   },
   "executeOnce": true
  },
