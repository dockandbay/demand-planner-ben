  {
   "id": "3c15fce4-551b-5dc9-9242-40d989868c5e",
   "name": "Build count",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1100,
    0
   ],
   "parameters": {
    "jsCode": "\nconst S = $('Settings').first().json, B = $('Claim batches').item.json;\nconst wh = (($('Read warehouse').item.json.body) || [])[0];\nconst prods = ($('Read products').item.json.body) || [];\nconst id = {}; prods.forEach(p => { id[String(p.code)] = p.id; });\nconst missing = B.lines.filter(l => id[l.sku] == null).map(l => l.sku);\nif (!wh || !wh.storage_location) return { json: { ok: false, batch: B, error: 'Fulfil warehouse \"' + B.warehouse + '\" not found in ' + S.tenant } };\nif (missing.length) return { json: { ok: false, batch: B, error: 'SKUs not in Fulfil ' + S.tenant + ': ' + missing.join(', ') } };\nconst lines = B.lines.map(l => ({ product: id[l.sku], quantity: Math.max(0, Number(l.set_to) || 0) }));\nreturn { json: { ok: true, batch: B, storage: wh.storage_location,\n  tenant: S.tenant, method: 'POST', path: '/model/stock.inventory' + '?context=' + encodeURIComponent(JSON.stringify({ company: S.companyId })), allow_prod_write: S.allowProdWrite === true, tag: { batch: B },\n  body: [{ company: S.companyId, location: wh.storage_location, lost_found: S.lostFoundId, date: B.date, type: 'cycle', reason: B.reason, lines: [['create', lines]] }] } };\n",
    "mode": "runOnceForEachItem"
   }
  },
