  {
   "id": "52c79acf-73f3-57a6-8a3a-af8b4d0d57f5",
   "name": "Prep complete",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1760,
    -80
   ],
   "parameters": {
    "jsCode": "\n// state rides in tag (the sub-workflow echoes it); on an error item fall back to the paired input\nconst S = $('Settings').first().json, res = $json; let t = res.tag; if (!t) { try { t = { batch: $('Build count').item.json.batch }; } catch (e) { t = {}; } }\nconst cid = res && res.data && res.data[0] ? (res.data[0].id || res.data[0]) : null;\nif (!res.ok || !cid) return { json: { ok: false, batch: t.batch, error: 'create failed: ' + JSON.stringify(res.error || res.data || res).slice(0, 400) } };\nreturn { json: { ok: true, batch: t.batch, count_id: cid, tenant: S.tenant, method: 'PUT', path: '/model/stock.inventory/' + cid + '/complete' + '?context=' + encodeURIComponent(JSON.stringify({ company: S.companyId })), body: [[cid]], allow_prod_write: S.allowProdWrite === true, tag: { batch: t.batch, count_id: cid } } };\n",
    "mode": "runOnceForEachItem"
   }
