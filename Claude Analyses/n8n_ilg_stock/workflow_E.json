{
 "name": "Fulfil | ILG stocktake [SANDBOX]",
 "nodes": [
  {
   "id": "d5e084cf-191b-5446-99af-714910feab42",
   "name": "About",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    -420,
    -380
   ],
   "parameters": {
    "content": "## Fulfil | ILG stocktake\nHORIZON \u25b8 Manage 3PL \u25b8 UK (ILG): a user ticks SKUs and presses **Send to Fulfil**. HORIZON queues the rebaseline and calls this webhook; a 15-minute sweep also picks up anything queued.\nPer batch: one **stock count** in the ILG warehouse's **Storage Zone** (UK ILG / ILG - FBA / ILG - VENDOR, found by name), each SKU set to HORIZON's 'set to' (Storage Zone now + report difference). Complete + confirm, so Fulfil books the change to **Lost and Found**. All writes go through the guarded **Fulfil | Request (sub-workflow)** (PROD writes need allowProdWrite). Read back, result posted to HORIZON.\nTest (SANDBOX only): POST the webhook with {\"test_batch\": {id, warehouse, date, reason, lines:[{sku, set_to}]}}.\nBuilt by Claude for Ben, 28-Oct-26.",
    "width": 640,
    "height": 300
   }
  },
  {
   "id": "19f68416-0c23-5649-a60a-ac3931cdb78e",
   "name": "Webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    -120
   ],
   "parameters": {
    "httpMethod": "POST",
    "path": "ilg-stocktake",
    "responseMode": "onReceived",
    "options": {}
   }
  },
  {
   "id": "b188fbce-6f69-56f5-b49e-d6686ba9d314",
   "name": "Every 15 min",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    100
   ],
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "*/15 * * * *"
      }
     ]
    }
   }
  },
  {
   "id": "65ab4a81-bc9a-5186-835a-bfc00df695ac",
   "name": "Settings",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    220,
    0
   ],
   "parameters": {
    "mode": "raw",
    "jsonOutput": "{\n  \"tenant\": \"SANDBOX\",\n  \"baseUrl\": \"https://dockandbay-sandbox.fulfil.io/api/v2\",\n  \"allowProdWrite\": false,\n  \"horizonUrl\": \"https://horizon.dockandbay.com\",\n  \"secret\": \"__HZ_SECRET__\",\n  \"lostFoundId\": 10,\n  \"companyId\": 1,\n  \"allowTestBatch\": true,\n  \"horizonEnabled\": false\n}",
    "options": {}
   }
  },
  {
   "id": "d46d520e-2c6a-5032-8ba4-6e09f49be135",
   "name": "Claim batches",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    0
   ],
   "parameters": {
    "jsCode": "\nconst S = $('Settings').first().json;\nconst fromHook = $('Webhook').isExecuted;\nlet batchId = null;\nif (fromHook) {\n  const h = $('Webhook').first().json;\n  if (String((h.headers || {})['x-webhook-secret'] || '') !== String(S.secret)) throw new Error('webhook: bad secret');\n  const b = h.body || {};\n  // test mode (SANDBOX only): run one synthetic batch without touching HORIZON\n  if (b.test_batch) { if (S.tenant !== 'SANDBOX' || S.allowTestBatch !== true) throw new Error('test_batch is only allowed on SANDBOX');\n    return [{ json: Object.assign({ test: true }, b.test_batch) }]; }\n  batchId = b.batch_id || null;\n}\nif (S.horizonEnabled !== true) return [];\nconst r = await this.helpers.httpRequest({ method: 'POST', url: S.horizonUrl + '/api/cron/ilg-rebaseline/claim', headers: { 'x-webhook-secret': S.secret }, body: batchId ? { batch_id: batchId } : {}, json: true, timeout: 60000 });\nreturn (r.batches || []).map(b => ({ json: b }));\n"
   }
  },
  {
