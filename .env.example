# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# v28.151 (review G3): every env var server.mjs / lib / api reads, names only (NO values). Blank = feature off or default.
# Required on Vercel (server refuses to boot without them): DATABASE_URL, PLANNER_KEY, N8N_WEBHOOK_SECRET.

# ---- Core ----
# Postgres connection string (Supabase session pooler :5432 locally; rewritten to :6543 on Vercel)
DATABASE_URL=
# Local dev escape hatch: use the transaction pooler (:6543) when the session pooler (cap 15) is exhausted
USE_TXN_POOLER=
# Read source for a sandbox reseed from live (local scripts/docs only; the server does not read it)
LIVE_DATABASE_URL=
# Access-gate key; blank locally = no gate. Required in prod
PLANNER_KEY=
# Shared secret for n8n -> server webhooks. Required in prod
N8N_WEBHOOK_SECRET=
# Comma-separated extra admin emails (on top of the built-in list)
ADMIN_EMAILS=
# Sandbox only: user attributed to actions when there is no auth proxy
DEV_USER=
# Local listen port / bind address (default 8124 / 127.0.0.1)
PORT=
HOST=
# Set by Vercel automatically (serverless mode); do not set locally
VERCEL=
NODE_ENV=

# ---- Hostnames / public URLs ----
# Host serving the admin app (default horizon.dockandbay.com)
ADMIN_HOST=
# Host serving the client portal (default client.dockandbay.com)
CLIENT_PORTAL_HOST=
# Public planner URL used in links/emails (default https://horizon.dockandbay.com)
PLANNER_URL=
# Public supplier-portal URL used in magic links (default https://suppliers.dockandbay.com/portal)
PORTAL_URL=

# ---- AI (Anthropic) ----
# Anthropic API key for /api/ai (server-side proxy)
ANTHROPIC_API_KEY=
# Workspace id header for org-scoped Anthropic keys (optional)
ANTHROPIC_WORKSPACE_ID=

# ---- Supabase Storage (uploads) ----
# Supabase project URL + service-role key (server only, never ship to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name (default horizon-uploads)
SUPABASE_STORAGE_BUCKET=
# Max single direct upload in MB; match the bucket limit (default 100)
STORAGE_MAX_MB=

# ---- Response cache (Vercel KV / Upstash REST) ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Email (Resend) ----
# Resend API key; blank = emails are previewed, not sent
RESEND_API_KEY=
# From address for portal/payment emails (default "Dock & Bay <portal@dockandbay.com>")
PORTAL_FROM=
# Reply-to address (default ops@dockandbay.com)
EMAIL_REPLY_TO=

# ---- Cin7 Omni (LIVE when set) ----
# Full "Basic <base64>" header or bare base64; or give CIN7_USERNAME + CIN7_KEY instead
CIN7_AUTH=
CIN7_USERNAME=
CIN7_KEY=

# ---- Fulfil ERP ----
# One subdomain + API key pair per environment (CONFIG > General settings picks the active one)
FULFIL_SANDBOX_SUBDOMAIN=
FULFIL_SANDBOX_API_KEY=
FULFIL_LIVE_SUBDOMAIN=
FULFIL_LIVE_API_KEY=
# Must be "true" to allow writes to LIVE Fulfil (kill switch; anything else blocks live writes)
FULFIL_LIVE_WRITES=
# "false" pushes PO headers without lines (default true)
FULFIL_LINES_SEND=

# ---- Xero (OAuth, UK + AU orgs) ----
# Shared app pair (fallback) ...
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# ... or one app per org (overrides the shared pair)
XERO_UK_CLIENT_ID=
XERO_UK_CLIENT_SECRET=
XERO_AU_CLIENT_ID=
XERO_AU_CLIENT_SECRET=
# OAuth redirect URI registered on the Xero app (default http://localhost:8124/api/supply/xero/callback)
XERO_REDIRECT_URI=
# Scope override (default includes offline_access)
XERO_SCOPES=

# ---- Logistics / tracking ----
# Flexport API token (FLEXPORT_API_KEY accepted as a legacy alias)
FLEXPORT_API_TOKEN=
FLEXPORT_API_KEY=
# DHL tracking API key
DHL_API_KEY=
# FedEx tracking OAuth (sandbox base by default; production also needs the account number)
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_API_BASE=
FEDEX_ACCOUNT_NUMBER=

# ---- BLADE (EU 3PL) ----
BLADE_USERNAME=
BLADE_PASSWORD=
# Warehouse code for stock calls (default BOC)
BLADE_WAREHOUSE_CODE=
# Optional manual override of the whole stock PUT body (diagnostics)
BLADE_STOCK_BODY=

# ---- Coghlans SFTP (AU 3PL) via proxy ----
COGHLANS_SFTP_HOST=
COGHLANS_SFTP_PORT=
COGHLANS_SFTP_USER=
COGHLANS_SFTP_PASSWORD=
WEBSHARE_PROXY_HOST=
WEBSHARE_PROXY_PORT=
WEBSHARE_PROXY_USER=
WEBSHARE_PROXY_PASSWORD=

# ---- DriveHQ WebDAV (per-country forecast CSV upload) ----
WEBDAV_BASE=
DRIVEHQ_USER=
DRIVEHQ_PASS=
# Target folder on DriveHQ (e.g. Forecasts)
TARGET_FOLDER=

# ---- Tuning / diagnostics (all optional) ----
# BI report cache TTL in ms (default 300000, min 30000)
BI_TTL_MS=
# Min ms between eager supply cache rebuilds (default 30000)
SUPPLY_REBUILD_MIN_MS=
# "0" sends every PO in full on the grid (default split ON)
PO_GRID_SPLIT=
# "0" disables the local supplier-portal prewarm (never runs on Vercel)
PORTAL_PREWARM=
# Log requests slower than this many ms (default 750)
HZ_SLOW_MS=
# Query log verbosity (default 0)
HZ_QLOG=
# Any value: log page-build timings
HZ_PROFILE=
# Any value: force the legacy per-query PO detail path (diagnostics)
HZ_PO_DETAIL_LEGACY=

# ACCOUNTS > Inbox matcher (v28.248): Google OAuth web client, Internal consent screen, scope gmail.readonly.
# Redirect URI <origin>/api/accounts/gmail/callback. Optional GMAIL_MAILBOX_ACCOUNTS (default accounts@dockandbay.com), GMAIL_REDIRECT_URI_ACCOUNTS.
GMAIL_CLIENT_ID_ACCOUNTS=
GMAIL_CLIENT_SECRET_ACCOUNTS=
