# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# Read-only connection to the demand planner database.
# Diviyaj will give you this string (use the DIRECT connection, not the pooler if asked).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Your own Anthropic API key (console.anthropic.com) — powers the AI features.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional. Leave blank for local development (no access gate locally).
# Only set this if you deploy and want to key-gate the app.
PLANNER_KEY=

# Cin7 Omni API auth — set EITHER form (the code accepts both):
#   CIN7_AUTH = "Basic <base64 of APIUsername:APIKey>"   (full header)
#   CIN7_AUTH = "<base64 of APIUsername:APIKey>"          (bare base64 — code adds "Basic ")
# Or instead provide the pair and the code encodes it: CIN7_USERNAME + CIN7_KEY.
CIN7_AUTH=
# CIN7_USERNAME=
# CIN7_KEY=

# DriveHQ WebDAV — per-country forecast CSV upload (HTTP PUT, Basic auth)
WEBDAV_BASE=
DRIVEHQ_USER=
DRIVEHQ_PASS=
TARGET_FOLDER=Forecasts
